# ---------------------------------------------------------------------------
# Dewa Surya Hub — portal (Next.js) environment variables.
# Copy to .env.local for `yarn dev`. NEXT_PUBLIC_* values are inlined at build
# time and are visible to the browser (they are not secrets).
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, hreflang, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hub API base URL including the version prefix (ADR-003 §3.1).
NEXT_PUBLIC_API_URL=http://localhost:8088/v1

# Optional server-only override for public ISR reads (e.g. an internal hostname).
# Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Shared secret the API sends in X-Revalidate-Secret to POST /api/revalidate
# (ADR-003 §11.1). On Cloudflare: `wrangler secret put REVALIDATE_SECRET`.
REVALIDATE_SECRET=change-me

# Firebase Web SDK (Google sign-in only, ADR-001 §5.7).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Midtrans Snap (checkout only). The client key is public; the server key lives in the API.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# "true" loads https://app.sandbox.midtrans.com/snap/snap.js, anything else the production Snap.
NEXT_PUBLIC_MIDTRANS_SANDBOX=true

# Ads on public (site) pages only (ADR-001 §5.2, ADR-009 §7.5). Leave empty to
# render nothing (production) / grey placeholders (development).
NEXT_PUBLIC_AD_CLIENT=
# Ad unit ids per slot (optional). Slots without an id render a reserved empty box.
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_END_OF_ARTICLE=
NEXT_PUBLIC_AD_SLOT_LIST=
# "true" shows grey placeholders where ads would be when no ad client is set.
NEXT_PUBLIC_AD_PLACEHOLDERS=false

# Server log level: debug | info | warn | error.
LOG_LEVEL=info

# Set to 1 to let `next dev` use Cloudflare bindings through Wrangler.
OPENNEXT_CLOUDFLARE_DEV=
