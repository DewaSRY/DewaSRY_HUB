{
  // Cloudflare Workers config for the portal (ADR-001 §5.2), built by `yarn preview` / `yarn deploy`.
  // Secrets (REVALIDATE_SECRET) are set with `wrangler secret put`, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dewa-surya-hub-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // Node.js runtime through nodejs_compat — no `runtime = "edge"` anywhere.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "services": [
    {
      // Self-reference, required by the OpenNext cache (name must match "name" above).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dewa-surya-hub-portal"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "dewa-surya-hub-portal-opennext-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "dewa-surya-hub-portal-tag-cache",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "vars": {
    // Public, non-secret values. NEXT_PUBLIC_* must also be present at build time (.env.production).
    "NEXT_PUBLIC_SITE_URL": "https://dewasuryahub.com",
    "NEXT_PUBLIC_API_URL": "https://api.dewasuryahub.com/v1"
  }
}
