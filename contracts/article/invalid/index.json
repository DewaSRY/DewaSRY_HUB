    },
    {
      "file": "too-deep.json",
      "expectedPath": "body.content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0].content[0]",
