# Copy to terraform.tfvars if you need to override a default. terraform.tfvars is gitignored.
# There are no secrets here any more: runtime config and secrets live in SSM Parameter Store under
# /hub/prod/ (docs/DEPLOYMENT.md §2.2), never in Terraform variables or state.

# aws_region    = "ap-southeast-1"
# instance_type = "t4g.small"

# Only one GitHub OIDC provider is allowed per AWS account. Set false if it already exists.
# create_github_oidc_provider = true

# Existing bucket for article images (the API's HUB_S3_BUCKET). Grants the instance role access.
# media_bucket_name = "hub-media-example"

# Refresh from https://www.cloudflare.com/ips-v4 when Cloudflare changes it.
# cloudflare_ipv4_cidrs = ["173.245.48.0/20", "..."]
